generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CompanyProfile {
  id           String   @id @default("default")
  name         String   @default("Lingkara Labs")
  address      String   @default("Dsn Babadan, Bantul, Bantul, DIY")
  phone        String   @default("082377673248")
  email        String   @default("eko.rismaryanto15@gmail.com")
  logoUrl      String?
  signatureUrl String?
  signerName   String   @default("Eko Rismaryanto")
  defaultNotes String   @default("Kirim ke Rekening BCA a.n Eko Rismaryanto no. rek 4560962725")
  updatedAt    DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountNumber String
  accountHolder String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  title          String        @default("Invoice")
  issueDate      String
  dueDate        String
  status         String        @default("DRAFT") // DRAFT, TERKIRIM, LUNAS, JATUH_TEMPO, BATAL
  
  // Company Snapshot
  companyName    String
  companyAddress String?
  companyPhone   String?
  companyEmail   String?
  companyLogo    String?

  // Client Snapshot
  clientId       String?
  clientName     String
  clientAddress  String?
  clientPhone    String?
  clientEmail    String?

  // Calculation
  subtotal       Float         @default(0)
  taxPercent     Float         @default(0)
  taxAmount      Float         @default(0)
  discount       Float         @default(0)
  total          Float         @default(0)

  // Notes & Signature
  notes          String?
  signatureImage String?
  signatureTitle String        @default("Hormat Kami,")
  signatureName  String?

  items          InvoiceItem[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     String
  description String?
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  amount      Float    @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}
